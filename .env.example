# Secretos y entorno local — copiar a `.env` y completar.
# NUNCA commitear `.env`.

# --- Activos y horizonte ---
TRADING_ASSETS=BTC,ETH
TRADING_HORIZON=24h

# --- Umbrales de accionabilidad ---
TRADING_MIN_PROB_NET=0.55
TRADING_MIN_CONFIDENCE=medium
TRADING_MAX_DATA_AGE_MIN=20
TRADING_MIN_HISTORY_DAYS=60

# --- Costos (puntos básicos) ---
TRADING_COMMISSION_BPS=6
TRADING_SLIPPAGE_BPS=4
TRADING_FUNDING_IMPACT=0.0002

# --- Infraestructura ---
TRADING_DB_PATH=var/trading.db
TRADING_LOG_LEVEL=INFO
TRADING_DEMO_MODE=true

# --- IA de explicación (opcional, nunca decide) ---
# Sin clave, el sistema publica la explicación determinista.
TRADING_LLM_ENABLED=false
TRADING_LLM_MODEL=gpt-4o-mini
TRADING_LLM_BASE_URL=https://api.openai.com/v1
TRADING_LLM_API_KEY=
# Compatibilidad: si no defines TRADING_LLM_API_KEY se usa OPENAI_API_KEY.
# OPENAI_API_KEY=sk-...
TRADING_LLM_PROMPT_VERSION=explain-signal-v1
TRADING_LLM_MONTHLY_BUDGET_USD=1.0
TRADING_LLM_MAX_OUTPUT_TOKENS=700
TRADING_LLM_INPUT_USD_PER_1K=0.00015
TRADING_LLM_OUTPUT_USD_PER_1K=0.0006
# Algunos proveedores no aceptan response_format JSON; desactivar si falla.
TRADING_LLM_JSON_MODE=true

# --- Entrega por Telegram (opcional) ---
# El panel sigue siendo la fuente de verdad; Telegram solo notifica.
TRADING_TELEGRAM_ENABLED=false
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_CHAT_ID=

# --- Proveedores de datos ---
# Binance no requiere clave (fuente principal).
# En GitHub Actions se usa el mirror publico de datos de Binance.
# BINANCE_BASE_URL=https://data-api.binance.vision/api/v3
# CoinGecko exige key desde 2026: solo si quieres usarlo como respaldo.
# COINGECKO_API_KEY=CG-...

# --- Futuro (NO usar todavía: ejecución real bloqueada) ---
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
